{
  "name": "workout-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "ratchet": "node scripts/quality-ratchet.mjs",
    "ratchet:update": "node scripts/quality-ratchet.mjs --update",
    "types:generate": "node scripts/generate-types.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons:generate": "node scripts/generate-icons.mjs",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "mcp:stdio": "node dist-mcp/stdio.js",
    "mcp:http": "node dist-mcp/http.js",
    "typecheck:mcp": "tsc -p tsconfig.mcp.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@supabase/supabase-js": "^2.39.7",
    "date-fns": "^3.3.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.2",
    "sonner": "^1.4.3",
    "zod": "^3.25.76",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^3.2.7"
  }
}
