# Copy to .env next to compose.yaml on the NAS. Never committed.
#
# EZ_SUPABASE_SERVICE_ROLE_KEY bypasses every RLS policy in the project. It is
# the reason this container publishes no ports and sits behind Cloudflare
# Access. Treat it like the database password it effectively is.

EZ_SUPABASE_URL=https://uqnamigtvtzlvbytfjgl.supabase.co
EZ_SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Access. Both are required in HTTP mode and the server refuses to
# start without them -- a server that cannot verify an assertion would be
# trusting a header, which is the same as no authentication at all.
#
# CF_ACCESS_AUD is the Application Audience tag of the "ez-workout MCP" Access
# app, from its Overview page. It is what stops a token minted for one of the
# other apps on this team domain (the WordPress admins, the SiYuan MCP) being
# accepted here.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
